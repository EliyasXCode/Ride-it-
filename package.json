{
  "name": "rideflow",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": "20.x"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently \"npm run dev --workspace=apps/api\" \"npm run dev --workspace=apps/web\"",
    "build": "npm run build --workspace=packages/shared && npm run build --workspace=apps/api",
    "start": "node apps/api/dist/index.js",
    "typecheck": "npm run typecheck --workspace=packages/shared && npm run typecheck --workspace=apps/api",
    "lint": "npm run lint --workspace=apps/api",
    "test": "npm run test --workspace=apps/api",
    "test:e2e": "npm run test:e2e --workspace=apps/web",
    "seed": "npm run seed --workspace=apps/api",
    "seed:admin": "npm run seed:admin --workspace=apps/api",
    "build:api": "npm run build --workspace=packages/shared && npm run build --workspace=apps/api",
    "start:api": "node apps/api/dist/index.js"
  },
  "dependencies": {
    "concurrently": "^8.2.2",
    "typescript": "^5.5.4"
  }
}
